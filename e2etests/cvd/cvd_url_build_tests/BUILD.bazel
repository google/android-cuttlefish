load("@rules_go//go:def.bzl", "go_test")

# Serves its own artifacts, so it needs neither the Android build servers nor
# a device.
go_test(
    name = "cvd_url_build_tests",
    size = "large",
    srcs = [
        "https_fixtures_test.go",
        "main_test.go",
    ],
    tags = [
        "exclusive",
        "external",
        "no-sandbox",
        "supports-graceful-termination",
    ],
    deps = [
        "//cvd/common",
    ],
)

go_test(
    name = "cvd_url_build_boot_tests",
    size = "large",
    srcs = [
        "boot_test.go",
        "https_fixtures_test.go",
    ],
    tags = [
        "exclusive",
        "external",
        "no-sandbox",
        "requires_ab",
        "supports-graceful-termination",
    ],
    deps = [
        "//cvd/common",
    ],
)
