load("@rules_go//go:def.bzl", "go_test")

_COMMON_TAGS = [
    "exclusive",
    "external",
    "no-sandbox",
    "requires_ab",
    "supports-graceful-termination",
]

go_test(
    name = "efi_loader_crosvm",
    size = "large",
    srcs = ["efi_loader_crosvm_test.go"],
    tags = _COMMON_TAGS,
    deps = ["//cvd/common"],
)

go_test(
    name = "efi_loader_qemu",
    size = "large",
    srcs = ["efi_loader_qemu_test.go"],
    tags = _COMMON_TAGS + ["podcvd_excluded"],
    deps = ["//cvd/common"],
)
