bazel_dep(name = "gazelle", version = "0.54.0")
bazel_dep(name = "rules_go", version = "0.65.0")
bazel_dep(name = "rules_python", version = "2.4.6")
bazel_dep(name = "rules_shell", version = "0.8.0")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.26.0")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")

# All *direct* Go dependencies of the module have to be listed explicitly.
use_repo(
    go_deps,
    "com_github_google_android_cuttlefish_frontend_src_host_orchestrator",
    "com_github_google_android_cuttlefish_frontend_src_libhoclient",
    "com_github_google_go_cmp",
)

bazel_dep(name = "com_github_google_android_cuttlefish_frontend")
local_path_override(
    module_name = "com_github_google_android_cuttlefish_frontend",
    path = "../frontend",
)
