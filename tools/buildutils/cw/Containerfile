ARG BASE_IMAGE=mirror.gcr.io/library/debian:bookworm-20250811
FROM ${BASE_IMAGE} AS base

ENV DEBIAN_FRONTEND=noninteractive

RUN apt update -y && apt upgrade -y
RUN apt install -y sudo

# DO NOT INSTALL custom packages here!

COPY ./tools/buildutils/ /buildutils/
RUN /buildutils/setup_build_env.sh && rm -rf /buildutils

ENTRYPOINT ["tools/buildutils/cw/entrypoint.sh"]
