load("//cuttlefish/bazel:rules.bzl", "cf_cc_library", "cf_cc_test")

package(
    default_visibility = ["//:android_cuttlefish"],
)

cf_cc_library(
    name = "netlink",
    srcs = [
        "netlink_client.cc",
        "netlink_request.cc",
    ],
    hdrs = [
        "netlink_client.h",
        "netlink_request.h",
    ],
    deps = [
        "//cuttlefish/common/libs/fs",
        "@abseil-cpp//absl/log",
    ],
)

cf_cc_library(
    name = "nfnetlink_socket",
    srcs = ["nfnetlink_socket.cc"],
    hdrs = ["nfnetlink_socket.h"],
    target_compatible_with = [
        "@platforms//os:linux",
    ],
    deps = [
        "//cuttlefish/common/libs/fs",
        "//cuttlefish/result",
    ],
)

cf_cc_library(
    name = "nft_messages",
    srcs = ["nft_messages.cc"],
    hdrs = ["nft_messages.h"],
    target_compatible_with = [
        "@platforms//os:linux",
    ],
    deps = [
        ":netlink",
        "//cuttlefish/posix:strerror",
        "//cuttlefish/result",
        "//linux_headers",
        "@abseil-cpp//absl/strings",
    ],
)

cf_cc_test(
    name = "nft_messages_test",
    srcs = ["nft_messages_test.cc"],
    deps = [
        ":netlink",
        ":nft_messages",
        "//allocd/test:nft_messages_helper",
        "//cuttlefish/result",
        "//cuttlefish/result:result_matchers",
        "//linux_headers",
    ],
)

cf_cc_library(
    name = "nft_nat_table",
    srcs = ["nft_nat_table.cc"],
    hdrs = ["nft_nat_table.h"],
    target_compatible_with = [
        "@platforms//os:linux",
    ],
    deps = [
        ":netlink",
        ":nfnetlink_socket",
        ":nft_messages",
        "//cuttlefish/result",
        "@abseil-cpp//absl/log",
    ],
)

cf_cc_test(
    name = "nft_nat_table_test",
    srcs = ["nft_nat_table_test.cc"],
    deps = [
        ":nft_nat_table",
        "//allocd/test:fake_nfnetlink_socket",
        "//allocd/test:nft_messages_helper",
        "//cuttlefish/result",
        "//cuttlefish/result:result_matchers",
        "//linux_headers",
    ],
)
