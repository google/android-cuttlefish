From b15065591665511e38c0dcd10066f8a8d28ded13 Mon Sep 17 00:00:00 2001
Subject: [PATCH 4/4] Define librootcanal_ffi.so and librootcanal libraries

---
 BUILD | 34 +++++++++++++++++++++++++++++-----
 1 file changed, 29 insertions(+), 5 deletions(-)

diff --git a/BUILD b/BUILD
index 2542248..fc2103f 100644
--- a/BUILD
+++ b/BUILD
@@ -33,9 +33,8 @@ cc_proto_library(
     deps = [":rootcanal_proto"],
 )
 
-cc_binary(
+cc_library(
     name = "librootcanal_ffi.so",
-    linkopts = ["-shared"],
     srcs = [
         "include/crypto/crypto.h",
         "include/hci/address.h",
@@ -93,6 +92,7 @@ cc_binary(
         "include",
         "rust/include",
     ],
+    linkstatic = False,
     visibility = ["//visibility:public"],
     deps = [
         ":rootcanal_config",
@@ -105,10 +105,9 @@ cc_binary(
     ],
 )
 
-cc_binary(
-    name = "rootcanal",
+cc_library(
+    name = "librootcanal",
     srcs = [
-        "desktop/root_canal_main.cc",
         "desktop/test_environment.cc",
         "desktop/test_environment.h",
         "include/crypto/crypto.h",
@@ -224,3 +223,28 @@ cc_binary(
     # breaks the device registration
     # features = ["-thin_lto"],
 )
+
+cc_binary(
+    name = "rootcanal",
+    srcs = [
+        "desktop/root_canal_main.cc",
+    ],
+    copts = [
+        "-std=c++20",
+        "-Wno-c99-designator",
+        "-Wno-google3-literal-operator",
+        "-Wno-pessimizing-move",
+        "-include",
+        "string.h",
+        "-I.",
+        "-fmacro-prefix-map=external/rootcanal/=",
+    ],
+    defines = [
+        "NDEBUG",
+        "_GNU_SOURCE",
+    ],
+    visibility = ["//visibility:public"],
+    deps = [
+        ":librootcanal",
+    ],
+)
