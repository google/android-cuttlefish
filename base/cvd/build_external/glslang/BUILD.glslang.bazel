load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_python//python:defs.bzl", "py_binary")

package(
    default_visibility = ["//visibility:public"],
)

COPTS = [
    "-DENABLE_HLSL"
]

py_binary(
    name = "build_info_py",
    srcs = ["build_info.py"],
    main = "build_info.py",
)

genrule(
    name = "build_info_h",
    srcs = [
        "CHANGES.md",
        "build_info.h.tmpl",
    ],
    outs = ["glslang/build_info.h"],
    cmd = "python3 $(location :build_info_py) $$(dirname $(location CHANGES.md)) -i $(location build_info.h.tmpl) -o $(location glslang/build_info.h)",
    tools = [":build_info_py"],
)

py_binary(
    name = "gen_extension_headers_py",
    srcs = ["gen_extension_headers.py"],
    main = "gen_extension_headers.py",
)

cc_library(
    name = "generic_code_gen",
    srcs = [
        "glslang/GenericCodeGen/CodeGen.cpp",
        "glslang/GenericCodeGen/Link.cpp",
    ],
    deps = [
        ":include",
    ],
)

cc_library(
    name = "glslang",
    srcs = [
        "glslang/CInterface/glslang_c_interface.cpp",
        "StandAlone/DirStackFileIncluder.h",
    ],
    deps = [
        ":machine_independent",
        ":os_dependent",
    ],
)

genrule(
    name = "glsl_intrinsic_header_h",
    srcs = ["glslang/ExtensionHeaders/GL_EXT_shader_realtime_clock.glsl"],
    outs = ["glslang/glsl_intrinsic_header.h"],
    cmd = "python3 $(location :gen_extension_headers_py) " +
        "-i $$(dirname $(location :glslang/ExtensionHeaders/GL_EXT_shader_realtime_clock.glsl)) " +
        "-o $(location glslang/glsl_intrinsic_header.h)",
    tools = [":gen_extension_headers_py"],
)

cc_binary(
    name = "glslang_validator",
    srcs = [
        ":glsl_intrinsic_header_h",
        "StandAlone/StandAlone.cpp",
        "StandAlone/Worklist.h",
    ],
    copts = [
        "-DENABLE_OPT=0",
        "-DENABLE_SPIRV=1",
    ],
    deps = [
        ":generic_code_gen",
        ":glslang",
        ":machine_independent",
        ":os_dependent",
        ":resource_limits",
        ":spirv",
    ],
)

cc_library(
    name = "include",
    hdrs = [
        "glslang/Include/BaseTypes.h",
        "glslang/Include/Common.h",
        "glslang/Include/ConstantUnion.h",
        "glslang/Include/InfoSink.h",
        "glslang/Include/InitializeGlobals.h",
        "glslang/Include/PoolAlloc.h",
        "glslang/Include/ResourceLimits.h",
        "glslang/Include/ShHandle.h",
        "glslang/Include/SpirvIntrinsics.h",
        "glslang/Include/Types.h",
        "glslang/Include/arrays.h",
        "glslang/Include/glslang_c_interface.h",
        "glslang/Include/glslang_c_shader_types.h",
        "glslang/Include/intermediate.h",
        "glslang/Include/visibility.h",
        "glslang/MachineIndependent/Versions.h",
        "glslang/Public/ResourceLimits.h",
        "glslang/Public/ShaderLang.h",
        "glslang/Public/resource_limits_c.h",
    ],
)

