        "SPIRV/SpvBuilder.cpp",
        "SPIRV/SpvBuilder.h",
        "SPIRV/SpvPostProcess.cpp",
        "SPIRV/SpvTools.cpp",
        "SPIRV/SpvTools.h",
        "SPIRV/bitutils.h",
        "SPIRV/disassemble.cpp",
        "SPIRV/disassemble.h",
        "SPIRV/doc.cpp",
        "SPIRV/doc.h",
        "SPIRV/hex_float.h",
        "SPIRV/spvIR.h",
        "SPIRV/spvUtil.h",
    ],
    textual_hdrs = [
        "SPIRV/spirv.hpp11",
    ],
    deps = [
        ":include",
        ":machine_independent",
    ],
)
