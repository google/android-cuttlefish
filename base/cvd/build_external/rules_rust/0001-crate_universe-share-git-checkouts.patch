+def _git_source_repo_name(hub_name, remote, commitish):
+    """Returns a deterministic repository name for a shared git checkout.
+
+    Args:
+        hub_name (str): The name of the hub repository.
+        remote (str): The git remote URL.
+        commitish (dict): The `commit`, `tag` or `branch` of the checkout.
+
+    Returns:
+        str: A valid repository name unique to `(remote, commitish)`.
+    """
+
+    # Bazel repository names only allow letters, digits, '-', '_' and '.', so
+    # reduce the remote URL (minus scheme and `.git` suffix) and the commitish
+    # to that alphabet, e.g. `https://chromium.googlesource.com/crosvm/crosvm`
+    # at `fd4df637...` becomes
+    # `<hub>__git_chromium_googlesource_com_crosvm_crosvm_fd4df63707ae`.
+    remote_name = remote.split("://")[-1].rstrip("/")
+    if remote_name.endswith(".git"):
+        remote_name = remote_name[:-len(".git")]
+    remote_name = "".join([c if c.isalnum() else "_" for c in remote_name.elems()])
+    ref = commitish.get("commit") or commitish.get("tag") or commitish.get("branch") or ""
+    ref = "".join([c if c.isalnum() else "_" for c in ref.elems()])
+    return "{}__git_{}_{}".format(hub_name, remote_name, ref[:12])
+
