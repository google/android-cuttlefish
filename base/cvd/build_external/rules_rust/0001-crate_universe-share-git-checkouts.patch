diff --git a/crate_universe/private/crate_from_git_source.bzl b/crate_universe/private/crate_from_git_source.bzl
new file mode 100644
index 0000000..a69219d
--- /dev/null
+++ b/crate_universe/private/crate_from_git_source.bzl
@@ -0,0 +1,76 @@
+"""A repository rule exposing one crate out of a shared git checkout.
+
+`crate_universe` resolves crates that come from git by cloning the remote. A
+Cargo workspace hosted in git therefore produces one `new_git_repository` per
+workspace member, each cloning the same remote at the same commit. For large
+workspaces this means dozens of identical clones per build, which is slow and
+trips server-side rate limiting.
+
+Instead, the `crate` module extension creates a single `new_git_repository` per
+`(remote, commitish)` and one `crate_from_git_source` repository per crate,
+which merely links the crate's subdirectory out of that shared checkout.
+"""
+
+load("@bazel_tools//tools/build_defs/repo:utils.bzl", "patch")
+
+# Files that belong to the repository rule output rather than the crate.
+_REPO_FILES = ["BUILD", "BUILD.bazel", "WORKSPACE", "WORKSPACE.bazel", "REPO.bazel", "MODULE.bazel"]
+
+def _crate_from_git_source_impl(repository_ctx):
+    # Resolving the label fetches the shared checkout if necessary.
+    source_root = repository_ctx.path(repository_ctx.attr.source).dirname
+    crate_dir = source_root
+    if repository_ctx.attr.strip_prefix:
+        crate_dir = source_root.get_child(*repository_ctx.attr.strip_prefix.split("/"))
+    if not crate_dir.exists:
+        fail("strip_prefix at {} does not exist in {}".format(
+            repository_ctx.attr.strip_prefix,
+            repository_ctx.attr.source,
+        ))
+
+    # Patched crates get a private copy so the shared checkout stays pristine;
+    # everything else is symlinked, like `git_repository` does for `strip_prefix`.
+    copy = bool(repository_ctx.attr.patches)
+    for entry in crate_dir.readdir():
+        if entry.basename in _REPO_FILES:
+            continue
+        if copy:
+            result = repository_ctx.execute(["cp", "-a", str(entry), entry.basename])
+            if result.return_code != 0:
+                fail("Failed to copy {}: {}".format(entry, result.stderr))
+        else:
+            repository_ctx.symlink(entry, entry.basename)
+
+    if copy:
+        patch(repository_ctx)
+
+    repository_ctx.file("BUILD.bazel", repository_ctx.attr.build_file_content)
+    repository_ctx.file("REPO.bazel", "")
+
+crate_from_git_source = repository_rule(
+    implementation = _crate_from_git_source_impl,
+    doc = "Exposes a single crate from a shared git checkout.",
+    attrs = {
+        "build_file_content": attr.string(
+            doc = "The content of the BUILD file for the crate.",
+            mandatory = True,
+        ),
+        "patch_args": attr.string_list(
+            doc = "The arguments given to the patch tool.",
+            default = ["-p0"],
+        ),
+        "patch_tool": attr.string(
+            doc = "The patch(1) utility to use.",
+        ),
+        "patches": attr.label_list(
+            doc = "A list of files that are to be applied as patches after linking the crate.",
+        ),
+        "source": attr.label(
+            doc = "A file at the root of the shared git checkout, typically its `BUILD.bazel`.",
+            mandatory = True,
+        ),
+        "strip_prefix": attr.string(
+            doc = "The directory of the crate within the shared checkout.",
+        ),
+    },
+)
