# this needs to be at parity with with build_external/crosvm/crosvm.config.toml
CROSVM_REMOTE = "https://chromium.googlesource.com/crosvm/crosvm"

CROSVM_REV = "7644716341320502d04d9b9e96d8bed591bb0c16"

RUTABAGA_REMOTE = "https://github.com/magma-gpu/rutabaga_gfx.git"

RUTABAGA_REV = "aefe66714318166a778920d26598ed93aa212578"

MINIJAIL_REMOTE = "https://chromium.googlesource.com/chromiumos/platform/minijail"

MINIJAIL_REV = "7845d89927a82dbdcdee6276837cd0978f69ba19"

# note that this won't use the same source checkout as the git_repository directive below
#
# The following `annotation` directives modify the generated bazel rules for
# individual crates in the crosvm dependency chart.
#
# See https://bazelbuild.github.io/rules_rust/crate_universe_bzlmod.html
crosvm_bin = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crosvm_bin.spec(
    artifact = "bin",
    default_features = False,
    features = [
        "android-sparse",
        "audio",
        "balloon",
        "composite-disk",
        "fs_runtime_ugid_map",
        "gdb",
        "gdbstub",
        "gdbstub_arch",
        "gfxstream",
        "gpu",
        "gpu_display",
        "net",
        "net_util",
        "qcow",
        "usb",
        "virgl_renderer",
        "wl-dmabuf",
    ],
    # TODO: schuffelen - fix the sandbox
    git = CROSVM_REMOTE,
    package = "crosvm",
    repositories = ["crosvm_bin"],
    rev = CROSVM_REV,
)
crosvm_bin.spec(
    artifact = "bin",
    features = [
        "gfxstream",
        "virgl_renderer",
        "vulkano",
    ],
    git = RUTABAGA_REMOTE,
    package = "broccolini",
    repositories = ["crosvm_bin"],
    rev = RUTABAGA_REV,
)
crosvm_bin.spec(
    features = [
        "gbm",
        "gfxstream",
        "virgl_renderer",
        "vulkano",
    ],
    git = RUTABAGA_REMOTE,
    package = "rutabaga_gfx",
    repositories = ["crosvm_bin"],
    rev = RUTABAGA_REV,
)
crosvm_bin.spec(
    git = MINIJAIL_REMOTE,
    package = "minijail-sys",
    repositories = ["crosvm_bin"],
    rev = MINIJAIL_REV,
)
crosvm_bin.annotation(
    crate = "broccolini",
    gen_all_binaries = True,
    repositories = ["crosvm_bin"],
    rustc_flags = [
        # Look for shared libraries in the same directory as the binary,
        # or in the adjacent lib64 directory.
        "-Clink-arg=-Wl,-rpath,$$ORIGIN",
        "-Clink-arg=-Wl,-rpath,$$ORIGIN/../lib64",
    ],
    deps = [
        "@@//:gbm",
        "@@//:gfxstream_backend_import",
        "@@//:virglrenderer_import",
    ],
)
crosvm_bin.annotation(
    crate = "crosvm",
    gen_all_binaries = True,
    patch_args = ["-p1"],
    patches = [
        "@//build_external/crosvm:PATCH.crosvm_01_nvidia_device_nodes.patch",
        "@//build_external/crosvm:PATCH.crosvm_02_render_server_runtime_mounts.patch",
        "@//build_external/crosvm:PATCH.crosvm_03_remote_context_types.patch",
    ],
    repositories = ["crosvm_bin"],
    rustc_flags = [
        # Look for shared libraries in the same directory as the binary,
        # or in the adjacent lib64 directory.
        "-Clink-arg=-Wl,-rpath,$$ORIGIN",
        "-Clink-arg=-Wl,-rpath,$$ORIGIN/../lib64",
    ],
    deps = [
        "@@//:gbm",
        "@@//:gfxstream_backend_import",
        "@@//:virglrenderer_import",
    ],
)
crosvm_bin.annotation(
    crate = "devices",
    patch_args = ["-p2"],
    patches = [
        "@//build_external/crosvm:PATCH.devices_01_prefer_descriptor_for_dmabufs.patch",
        "@//build_external/crosvm:PATCH.devices_02_remote_context_types.patch",
        "@//build_external/crosvm:PATCH.devices_03_fencing.patch",
    ],
    repositories = ["crosvm_bin"],
)
crosvm_bin.annotation(
    crate = "gpu_display",
    patch_args = ["-p2"],
    patches = [
        "@//build_external/crosvm:PATCH.gpu_display_01_fencing.patch",
    ],
    repositories = ["crosvm_bin"],
)
crosvm_bin.annotation(
    crate = "rutabaga_gfx",
    gen_build_script = "off",
    override_target_lib = "@//build_external/crosvm:rutabaga_gfx",
    repositories = ["crosvm_bin"],
    version = "=0.1.80",
)
crosvm_bin.annotation(
    crate = "rutabaga_gfx",
    crate_features = [
        "gbm",
        "gfxstream",
        "virgl_renderer",
        "vulkano",
    ],
    gen_build_script = "off",
    repositories = ["crosvm_bin"],
    rustc_flags = [
        "--cfg=gfxstream_unstable",
        # Look for shared libraries in the same directory as this object,
        # or in the adjacent lib64 directory.
        "-Clink-arg=-Wl,-rpath,$$ORIGIN",
        "-Clink-arg=-Wl,-rpath,$$ORIGIN/../lib64",
    ],
    version = "=0.1.85",
    deps = [
        "@@//:gbm",
        "@@//:gfxstream_backend_import",
        "@@//:virglrenderer_import",
    ],
)
crosvm_bin.annotation(
    build_script_data = ["@@//:compile_seccomp_policy_exe"],
    build_script_data_glob = ["seccomp/**"],
    build_script_env = {"COMPILE_SECCOMP_POLICY": "$(execpath @@//:compile_seccomp_policy_exe)"},
    crate = "jail",
    patch_args = ["-p2"],
    patches = [
        "@//build_external/crosvm:PATCH.jail_01_inline_gpu_common_policy.patch",
        "@//build_external/crosvm:PATCH.jail_02_broccolini_seccomp_policy.patch",
    ],
    repositories = ["crosvm_bin"],
)

# minijail-sys/build.rs invokes `make` to build the minijail C library, so all
# the sources need to be made available to it at runtime in a filegroup.
# rules_rust only checks out the crate directory and the C sources are two
# directories above, so we grab them from the submodule checkout in our crosvm
# git_repository.
crosvm_bin.annotation(
    additive_build_file_content = """
genrule(
    name = "libminijailpreload_so",
    srcs = [":build_script_build"],
    outs = ["libminijailpreload.so"],
    cmd = "cp $(location :build_script_build)/libminijailpreload.so $@",
)
""",
    build_script_data = ["@@//:minijail_sources"],
    build_script_rundir = "external/+_repo_rules+crosvm/third_party/minijail",
    crate = "minijail-sys",
    extra_aliased_targets = {
        "minijail_sys_libminijailpreload_so": "libminijailpreload_so",
    },
    patch_args = ["-p1"],
    # crates_universe checks out only a subdirectory of the repository, so the
    # file paths in this patch are relative to that directory.
    patches = ["@//build_external/crosvm:PATCH.minijail-sys_build_rs.patch"],
    repositories = ["crosvm_bin"],
)

# Disable the `path` directives for the generated code as they end up with
# temporary paths within the bazel sandbox.
crosvm_bin.annotation(
    crate = "proto_build_tools",
    patch_args = ["-p1"],
    # crates_universe checks out only a subdirectory of the repository, so the
    # file paths in this patch are relative to that directory.
    patches = ["@//build_external/crosvm:PATCH.proto_build_tools.patch"],
    repositories = ["crosvm_bin"],
)
crosvm_bin.from_specs(
    name = "crosvm_bin",
    cargo_config = "@//build_external/crosvm:crosvm.config.toml",
    # Executable dependencies are an unstable cargo feature.
    host_tools = "@rust_host_tools_nightly",
)
use_repo(crosvm_bin, "crosvm_bin")

git_repository = use_repo_rule("@bazel_tools//tools/build_defs/repo:git.bzl", "git_repository")

git_repository(
    name = "crosvm",
    build_file = "@//build_external/crosvm:BUILD.crosvm.bazel",
    commit = CROSVM_REV,
    init_submodules = True,
    patch_args = ["-p1"],
    patches = [
        "@//build_external/crosvm:PATCH.minijail-sys_common_mk.patch",
        "@//build_external/crosvm:PATCH.minijail_gen_constants.patch",
        "@//build_external/crosvm:PATCH.minijail_preloadpath.patch",
    ],
    remote = CROSVM_REMOTE,
)
