@@ -130,6 +130,27 @@ pub struct VirtioScanoutBlobData {
 enum VirtioGpuRing {
     Global,
     ContextSpecific { ctx_id: u32, ring_idx: u8 },
+    DisplayFlip { flip_id: u64 },
+}
+
+impl VirtioGpuRing {
+    fn from_rutabaga_fence(fence: &RutabagaFence) -> Self {
+        match fence.flags & VIRTIO_GPU_FLAG_INFO_RING_IDX {
+            0 => VirtioGpuRing::Global,
+            _ => VirtioGpuRing::ContextSpecific {
+                ctx_id: fence.ctx_id,
+                ring_idx: fence.ring_idx,
+            },
+        }
+    }
+}
+
+enum GpuFenceResult {
+    SignalFence,
+    DeferSignalingFence {
+        ring: VirtioGpuRing,
+        fence_id: u64,
+    },
 }
 
 struct FenceDescriptor {
@@ -157,6 +178,72 @@ struct FenceStateSnapshot {
 }
 
 impl FenceState {
+    fn is_completed(&self, ring: &VirtioGpuRing, fence_id: u64) -> bool {
+        match ring {
+            VirtioGpuRing::DisplayFlip { .. } => false,
+            _ => fence_id <= *self.completed_fences.get(ring).unwrap_or(&0),
+        }
+    }
+
+    /// Adds `desc_chain` to the pending descriptors on `ring` unless `fence_id` has already
+    /// completed on that timeline, in which case `Some(ReturnDescriptor)` is returned for
+    /// immediate completion.
+    fn defer_descriptor(
+        &mut self,
+        ring: VirtioGpuRing,
+        fence_id: u64,
+        desc_chain: DescriptorChain,
+        len: u32,
+    ) -> Option<ReturnDescriptor> {
+        if self.is_completed(&ring, fence_id) {
+            return Some(ReturnDescriptor { desc_chain, len });
+        }
+
+        self.descs.push(FenceDescriptor {
+            ring,
+            fence_id,
+            desc_chain,
+            len,
+        });
+        None
+    }
+
+    /// Signals completion up to `completed_fence_id` on `ring`, returning any matching pending
+    /// descriptors to `queue`. Returns `true` if at least one descriptor was returned.
+    fn signal_ring(
+        &mut self,
+        ring: VirtioGpuRing,
+        completed_fence_id: u64,
+        queue: &dyn QueueReader,
+    ) -> bool {
+        let mut signal = false;
+        let mut i = 0;
+        while i < self.descs.len() {
+            let completed = match (&self.descs[i].ring, &ring) {
+                (
+                    VirtioGpuRing::DisplayFlip { flip_id: desc_flip },
+                    VirtioGpuRing::DisplayFlip { flip_id },
+                ) => desc_flip == flip_id,
+                (desc_ring, target_ring) => {
+                    desc_ring == target_ring && self.descs[i].fence_id <= completed_fence_id
+                }
+            };
+            if completed {
+                let completed_desc = self.descs.remove(i);
+                queue.add_used(completed_desc.desc_chain, completed_desc.len);
+                signal = true;
+            } else {
+                i += 1;
+            }
+        }
+
+        if !matches!(ring, VirtioGpuRing::DisplayFlip { .. }) {
+            self.completed_fences.insert(ring, completed_fence_id);
+        }
+
+        signal
+    }
+
     fn snapshot(&self) -> FenceStateSnapshot {
         assert!(self.descs.is_empty(), "can't snapshot with pending fences");
         FenceStateSnapshot {
