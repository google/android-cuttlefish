+    fn finalize_rutabaga_fence(
+        &mut self,
+        mut resp: VirtioGpuResult,
+        fence: Option<RutabagaFence>,
+    ) -> (VirtioGpuResult, GpuFenceResult) {
+        let fence_result = match fence {
+            Some(fence) => match self.virtio_gpu.create_fence(fence) {
+                Ok(_) => {
+                    let ring = VirtioGpuRing::from_rutabaga_fence(&fence);
+                    if self.fence_state.lock().is_completed(&ring, fence.fence_id) {
+                        GpuFenceResult::SignalFence
+                    } else {
+                        GpuFenceResult::DeferSignalingFence {
+                            ring,
+                            fence_id: fence.fence_id,
+                        }
+                    }
+                }
+                Err(fence_resp) => {
+                    warn!("create_fence {} -> {:?}", fence.fence_id, fence_resp);
+                    resp = Err(fence_resp);
+                    GpuFenceResult::SignalFence
+                }
+            },
+            None => GpuFenceResult::SignalFence,
+        };
+
+        (resp, fence_result)
+    }
