+    /// Completes any pending `VirtioGpuRing::DisplayFlip` descriptors whose buffers have been
+    /// released by the display compositor.
+    pub fn complete_display_flips(&mut self, queue: &dyn QueueReader) -> bool {
+        let completed_flips = self.virtio_gpu.take_completed_display_flips();
+        if completed_flips.is_empty() {
+            return false;
+        }
