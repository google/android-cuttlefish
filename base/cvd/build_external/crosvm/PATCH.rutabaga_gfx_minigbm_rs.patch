+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::rutabaga_gralloc::gralloc::*;
+
+    #[test]
+    fn test_flag_translation() {
+        let empty = RutabagaGrallocFlags::empty();
+        assert_eq!(rutabaga_gralloc_flags_to_gbm_flags(empty), 0);
+
+        let scanout = RutabagaGrallocFlags::new(RUTABAGA_GRALLOC_USE_SCANOUT);
+        assert_eq!(
+            rutabaga_gralloc_flags_to_gbm_flags(scanout),
+            GBM_BO_USE_SCANOUT
+        );
+
+        // Bit 1 (legacy USE_CURSOR in minigbm) is intentionally omitted from RutabagaGrallocFlags and translates to 0.
+        let cursor = RutabagaGrallocFlags::new(1 << 1);
+        assert_eq!(rutabaga_gralloc_flags_to_gbm_flags(cursor), 0);
+
+        let rendering = RutabagaGrallocFlags::new(RUTABAGA_GRALLOC_USE_RENDERING);
+        assert_eq!(
+            rutabaga_gralloc_flags_to_gbm_flags(rendering),
+            GBM_BO_USE_RENDERING
+        );
+
+        let linear = RutabagaGrallocFlags::new(RUTABAGA_GRALLOC_USE_LINEAR);
+        assert_eq!(
+            rutabaga_gralloc_flags_to_gbm_flags(linear),
+            GBM_BO_USE_LINEAR
+        );
+
+        // Crucial: Minigbm BO_USE_TEXTURE (1 << 5) must NOT translate to Mesa GBM_BO_USE_PROTECTED (1 << 5).
+        let texture = RutabagaGrallocFlags::new(RUTABAGA_GRALLOC_USE_TEXTURING);
+        assert_eq!(rutabaga_gralloc_flags_to_gbm_flags(texture), 0);
+
+        // Crucial: Minigbm BO_USE_CAMERA_WRITE (1 << 6) must NOT translate to Mesa GBM_BO_USE_FRONT_RENDERING (1 << 6).
+        let camera_write = RutabagaGrallocFlags::new(RUTABAGA_GRALLOC_USE_CAMERA_WRITE);
+        assert_eq!(rutabaga_gralloc_flags_to_gbm_flags(camera_write), 0);
+
+        // Crucial: Minigbm BO_USE_CAMERA_READ (1 << 7) must NOT translate to Mesa compression flags.
+        let camera_read = RutabagaGrallocFlags::new(RUTABAGA_GRALLOC_USE_CAMERA_READ);
+        assert_eq!(rutabaga_gralloc_flags_to_gbm_flags(camera_read), 0);
+
+        // Minigbm BO_USE_PROTECTED (1 << 8) translates to Mesa GBM_BO_USE_PROTECTED (1 << 5).
+        let protected = RutabagaGrallocFlags::new(RUTABAGA_GRALLOC_USE_PROTECTED);
+        assert_eq!(
+            rutabaga_gralloc_flags_to_gbm_flags(protected),
+            GBM_BO_USE_PROTECTED
+        );
+
+        // Minigbm SW and HW video flags should be filtered out.
+        let sw_read = RutabagaGrallocFlags::new(RUTABAGA_GRALLOC_USE_SW_READ_OFTEN);
+        assert_eq!(rutabaga_gralloc_flags_to_gbm_flags(sw_read), 0);
+        let sw_write = RutabagaGrallocFlags::new(RUTABAGA_GRALLOC_USE_SW_WRITE_OFTEN);
+        assert_eq!(rutabaga_gralloc_flags_to_gbm_flags(sw_write), 0);
+        let video_dec = RutabagaGrallocFlags::new(RUTABAGA_GRALLOC_VIDEO_DECODER);
+        assert_eq!(rutabaga_gralloc_flags_to_gbm_flags(video_dec), 0);
+
+        // Combined flags: scanout | rendering | texture -> SCANOUT | RENDERING (no PROTECTED)
+        let combined = RutabagaGrallocFlags::new(
+            RUTABAGA_GRALLOC_USE_SCANOUT
+                | RUTABAGA_GRALLOC_USE_RENDERING
+                | RUTABAGA_GRALLOC_USE_TEXTURING,
+        );
+        assert_eq!(
+            rutabaga_gralloc_flags_to_gbm_flags(combined),
+            GBM_BO_USE_SCANOUT | GBM_BO_USE_RENDERING
+        );
+    }
+
+    #[test]
+    fn test_scanout_forces_map_info_wc() {
+        let mut gralloc = match MinigbmDevice::init() {
+            Ok(g) => g,
+            Err(_) => return, // Skip if no DRM device is accessible
+        };
+
+        // Scanout buffer must always be mapped as Write-Combining (WC)
+        let scanout_info = ImageAllocationInfo {
+            width: 64,
+            height: 64,
+            drm_format: DrmFormat::new(b'X', b'R', b'2', b'4'),
+            flags: RutabagaGrallocFlags::empty().use_scanout(true),
+        };
+        let scanout_reqs = gralloc.get_image_memory_requirements(scanout_info).unwrap();
+        assert_eq!(scanout_reqs.map_info, RUTABAGA_MAP_CACHE_WC);
+
+        // Non-scanout buffer with host_cached requested (SW_READ_OFTEN)
+        // Must NOT blindly set CACHED unless device is i915 or xe
+        let non_scanout_info = ImageAllocationInfo {
+            width: 64,
+            height: 64,
+            drm_format: DrmFormat::new(b'X', b'R', b'2', b'4'),
+            flags: RutabagaGrallocFlags::empty()
+                .use_rendering(true)
+                .use_sw_read(true),
+        };
+        let non_scanout_reqs = gralloc
+            .get_image_memory_requirements(non_scanout_info)
+            .unwrap();
+        assert!(
+            non_scanout_reqs.map_info == RUTABAGA_MAP_CACHE_WC
+                || non_scanout_reqs.map_info == RUTABAGA_MAP_CACHE_CACHED
+        );
+    }
+
+    #[test]
+    fn test_sequential_get_requirements_and_fallback() {
+        let mut gralloc = match MinigbmDevice::init() {
+            Ok(g) => g,
+            Err(_) => return, // Skip if no DRM device is accessible
+        };
+
+        let info1 = ImageAllocationInfo {
+            width: 64,
+            height: 64,
+            drm_format: DrmFormat::new(b'X', b'R', b'2', b'4'),
+            flags: RutabagaGrallocFlags::new(RUTABAGA_GRALLOC_USE_TEXTURING),
+        };
+
+        let info2 = ImageAllocationInfo {
+            width: 128,
+            height: 128,
+            drm_format: DrmFormat::new(b'X', b'R', b'2', b'4'),
+            flags: RutabagaGrallocFlags::new(
+                RUTABAGA_GRALLOC_USE_RENDERING | RUTABAGA_GRALLOC_USE_TEXTURING,
+            ),
+        };
+
+        // Sequential queries must not fail with AlreadyInUse
+        let reqs1 = gralloc.get_image_memory_requirements(info1).unwrap();
+        assert!(reqs1.size > 0);
+
+        let reqs2 = gralloc.get_image_memory_requirements(info2).unwrap();
+        assert!(reqs2.size > 0);
+
+        // Allocate memory for reqs1 when stashed buffer has info2 dimensions (mismatch fallback)
+        let handle1 = gralloc.allocate_memory(reqs1);
+        assert!(handle1.is_ok());
+
+        // Subsequent allocate without stashed buffer (clean fallback)
+        let handle2 = gralloc.allocate_memory(reqs2);
+        assert!(handle2.is_ok());
+    }
