load("//cuttlefish/bazel:rules.bzl", "cf_build_test", "cf_cc_library")

package(
    default_visibility = ["//:android_cuttlefish"],
)

cf_build_test(name = "transport_build_test")

cf_cc_library(
    name = "channel",
    srcs = ["channel.cpp"],
    hdrs = ["channel.h"],
    deps = [
        "//cuttlefish/result:expect",
        "//cuttlefish/result:result_type",
    ],
)

cf_cc_library(
    name = "transport",
    srcs = ["channel_sharedfd.cpp"],
    hdrs = ["channel_sharedfd.h"],
    deps = [
        "//cuttlefish/common/libs/fs",
        "//cuttlefish/common/libs/fs:fd",
        "//cuttlefish/common/libs/transport:channel",
        "//cuttlefish/io:write_exact",
        "//cuttlefish/result:expect",
        "//cuttlefish/result:result_type",
        "@abseil-cpp//absl/log",
    ],
)
