load("//cuttlefish/bazel:rules.bzl", "cf_build_test", "cf_cc_library")

package(
    default_visibility = ["//:android_cuttlefish"],
)

cf_build_test(name = "credential_source_build_test")

cf_cc_library(
    name = "credential_source",
    hdrs = ["credential_source.h"],
    deps = [
        "//cuttlefish/result:result_type",
    ],
)

cf_cc_library(
    name = "fixed_credential_source",
    srcs = ["fixed_credential_source.cc"],
    hdrs = ["fixed_credential_source.h"],
    deps = [
        "//cuttlefish/host/libs/web/credential_source",
        "//cuttlefish/result:result_type",
    ],
)

cf_cc_library(
    name = "refreshing_credential_source",
    srcs = ["refreshing_credential_source.cc"],
    hdrs = ["refreshing_credential_source.h"],
    deps = [
        "//cuttlefish/host/libs/web/credential_source",
        "//cuttlefish/result:expect",
        "//cuttlefish/result:result_type",
    ],
)
