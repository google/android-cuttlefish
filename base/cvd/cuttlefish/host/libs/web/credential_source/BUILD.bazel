load("//cuttlefish/bazel:rules.bzl", "cf_build_test", "cf_cc_library")

package(
    default_visibility = ["//:android_cuttlefish"],
)

cf_build_test(name = "credential_source_build_test")

cf_cc_library(
    name = "credential_source",
    hdrs = ["credential_source.h"],
    deps = [
        "//cuttlefish/result:result_type",
    ],
)

cf_cc_library(
    name = "fixed_credential_source",
    srcs = ["fixed_credential_source.cc"],
    hdrs = ["fixed_credential_source.h"],
    deps = [
        "//cuttlefish/host/libs/web/credential_source",
        "//cuttlefish/result:result_type",
    ],
)

cf_cc_library(
    name = "gce_metadata_credential_source",
    srcs = ["gce_metadata_credential_source.cc"],
    hdrs = ["gce_metadata_credential_source.h"],
    deps = [
        "//cuttlefish/host/libs/web/credential_source",
        "//cuttlefish/host/libs/web/credential_source:refreshing_credential_source",
        "//cuttlefish/host/libs/web/http_client",
        "//cuttlefish/host/libs/web/http_client:http_json",
        "//cuttlefish/result:expect",
        "//cuttlefish/result:result_type",
        "@jsoncpp",
    ],
)

cf_cc_library(
    name = "refreshing_credential_source",
    srcs = ["refreshing_credential_source.cc"],
    hdrs = ["refreshing_credential_source.h"],
    deps = [
        "//cuttlefish/host/libs/web/credential_source",
        "//cuttlefish/result:expect",
        "//cuttlefish/result:result_type",
    ],
)

cf_cc_library(
    name = "refresh_token_credential_source",
    srcs = ["refresh_token_credential_source.cc"],
    hdrs = ["refresh_token_credential_source.h"],
    deps = [
        "//cuttlefish/common/libs/utils:json",
        "//cuttlefish/host/libs/web/credential_source",
        "//cuttlefish/host/libs/web/credential_source:refreshing_credential_source",
        "//cuttlefish/host/libs/web/http_client",
        "//cuttlefish/host/libs/web/http_client:http_json",
        "//cuttlefish/host/libs/web/http_client:url_escape",
        "//cuttlefish/result:expect",
        "//cuttlefish/result:result_type",
        "@abseil-cpp//absl/strings",
        "@jsoncpp",
    ],
)

cf_cc_library(
    name = "service_account_oauth_credential_source",
    srcs = ["service_account_oauth_credential_source.cc"],
    hdrs = ["service_account_oauth_credential_source.h"],
    deps = [
        "//cuttlefish/common/libs/utils:base64",
        "//cuttlefish/host/libs/web/credential_source:refreshing_credential_source",
        "//cuttlefish/host/libs/web/http_client",
        "//cuttlefish/host/libs/web/http_client:http_json",
        "//cuttlefish/host/libs/web/http_client:url_escape",
        "//cuttlefish/result:expect",
        "//cuttlefish/result:result_type",
        "@abseil-cpp//absl/strings",
        "@boringssl//:crypto",
        "@jsoncpp",
    ],
)
