// Packed 8888 RGBA to NV12, BT.709 limited range, one invocation per 2x2
// pixel block writing four luma texels and one chroma texel. The arithmetic
// is integer and matches the host side converter exactly, so either path
// produces the same bytes.
//
// The source is read as one uint per pixel, which takes the byte at offset i
// of a pixel to bits i*8 of the uint and so assumes a little endian host.

#version 460

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer SourcePixels {
    uint pixels[];
} uSource;

layout(set = 0, binding = 1, r8) uniform writeonly image2D uLuma;

layout(set = 0, binding = 2, rg8) uniform writeonly image2D uChroma;

layout(push_constant) uniform Params {
    // The frame as the caller sees it. Coordinates beyond it repeat the edge
    // pixel, so the padding the coded alignment adds costs as few bits as
    // possible.
    uint visibleWidth;
    uint visibleHeight;
    // The frame size rounded up to the driver's coded picture alignment.
    uint codedWidth;
    uint codedHeight;
    // Distance between source rows, in pixels.
    uint sourceStridePixels;
    // Byte offset of red within a pixel: 0 where blue comes last, 2 where it
    // comes first.
    uint redOffset;
} uParams;

ivec3 RgbToYuv(int r, int g, int b) {
    return ivec3(((46 * r + 157 * g + 16 * b + 128) >> 8) + 16,
                 ((-26 * r - 87 * g + 113 * b + 128) >> 8) + 128,
                 ((112 * r - 102 * g - 10 * b + 128) >> 8) + 128);
}

void main() {
    uvec2 block = gl_GlobalInvocationID.xy;
    if (block.x * 2u >= uParams.codedWidth ||
        block.y * 2u >= uParams.codedHeight) {
        return;
    }

    uint blueOffset = 2u - uParams.redOffset;
    uint x = block.x * 2u;
    uint y = block.y * 2u;

    int uSum = 0;
    int vSum = 0;
    for (uint dy = 0u; dy < 2u; dy++) {
        for (uint dx = 0u; dx < 2u; dx++) {
            uint sourceX = min(x + dx, uParams.visibleWidth - 1u);
            uint sourceY = min(y + dy, uParams.visibleHeight - 1u);
            uint texel =
                uSource.pixels[sourceY * uParams.sourceStridePixels + sourceX];
            int r = int((texel >> (uParams.redOffset * 8u)) & 0xffu);
            int g = int((texel >> 8u) & 0xffu);
            int b = int((texel >> (blueOffset * 8u)) & 0xffu);
            ivec3 yuv = RgbToYuv(r, g, b);
            imageStore(uLuma, ivec2(x + dx, y + dy),
                       vec4(float(clamp(yuv.x, 0, 255)) / 255.0, 0.0, 0.0, 0.0));
            uSum += yuv.y;
            vSum += yuv.z;
        }
    }

    imageStore(uChroma, ivec2(block),
               vec4(float(clamp(uSum / 4, 0, 255)) / 255.0,
                    float(clamp(vSum / 4, 0, 255)) / 255.0, 0.0, 0.0));
}
