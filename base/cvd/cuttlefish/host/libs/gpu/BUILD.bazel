load("//cuttlefish/bazel:rules.bzl", "cf_cc_library", "cf_cc_test")

package(
    default_visibility = ["//:android_cuttlefish"],
)

cf_cc_library(
    name = "cuda_loader",
    srcs = ["cuda_loader.cpp"],
    hdrs = ["cuda_loader.h"],
    include_cleaner_enabled = False,
    linkopts = ["-ldl"],
    deps = [
        "//cuttlefish/result",
        "@cuda//:cudart_headers",
    ],
)

cf_cc_library(
    name = "nvenc_loader",
    srcs = ["nvenc_loader.cpp"],
    hdrs = ["nvenc_loader.h"],
    include_cleaner_enabled = False,
    linkopts = ["-ldl"],
    deps = [
        "//cuttlefish/result",
        "@nv_codec_headers//:nv_headers",
    ],
)

cf_cc_library(
    name = "cuda_context",
    srcs = ["cuda_context.cpp"],
    hdrs = ["cuda_context.h"],
    include_cleaner_enabled = False,
    deps = [
        ":cuda_loader",
        "//cuttlefish/result",
        "@abseil-cpp//absl/log",
        "@cuda//:cudart_headers",
    ],
)

cf_cc_library(
    name = "nvenc_capabilities",
    srcs = ["nvenc_capabilities.cpp"],
    hdrs = ["nvenc_capabilities.h"],
    include_cleaner_enabled = False,
    deps = [
        ":cuda_context",
        ":cuda_loader",
        ":nvenc_loader",
        "@abseil-cpp//absl/log",
        "@nv_codec_headers//:nv_headers",
    ],
)

cf_cc_library(
    name = "vulkan_loader",
    srcs = ["vulkan_loader.cpp"],
    hdrs = ["vulkan_loader.h"],
    linkopts = ["-ldl"],
    deps = [
        "//cuttlefish/result",
        "@vulkan_headers",
    ],
)

cf_cc_library(
    name = "vulkan_av1_capabilities",
    srcs = ["vulkan_av1_capabilities.cpp"],
    hdrs = ["vulkan_av1_capabilities.h"],
    deps = [
        ":vulkan_loader",
        "//cuttlefish/result",
        "@abseil-cpp//absl/log",
        "@vulkan_headers",
    ],
)

cf_cc_test(
    name = "vulkan_av1_capabilities_test",
    srcs = ["vulkan_av1_capabilities_test.cpp"],
    deps = [
        ":vulkan_av1_capabilities",
        "//cuttlefish/result:result_matchers",
        "@vulkan_headers",
    ],
)

cf_cc_library(
    name = "vulkan_video_context",
    srcs = ["vulkan_video_context.cpp"],
    hdrs = ["vulkan_video_context.h"],
    deps = [
        ":vulkan_av1_capabilities",
        ":vulkan_loader",
        "//cuttlefish/result",
        "@abseil-cpp//absl/log",
        "@vulkan_headers",
    ],
)

cf_cc_test(
    name = "vulkan_video_context_test",
    srcs = ["vulkan_video_context_test.cpp"],
    deps = [
        ":vulkan_video_context",
        "//cuttlefish/result",
        "//cuttlefish/result:result_matchers",
        "@vulkan_headers",
    ],
)
