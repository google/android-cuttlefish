load("//cuttlefish/bazel:rules.bzl", "cf_cc_library")

package(
    default_visibility = ["//:android_cuttlefish"],
)

cf_cc_library(
    name = "archive",
    srcs = ["archive.cc"],
    hdrs = ["archive.h"],
    features = ["-layering_check"],  # libzip
    linkstatic = True,  # libzip
    deps = [
        "//cuttlefish/host/libs/zip/libzip_cc:error",
        "//cuttlefish/host/libs/zip/libzip_cc:managed",
        "//cuttlefish/host/libs/zip/libzip_cc:readable_source",
        "//cuttlefish/host/libs/zip/libzip_cc:seekable_source",
        "//cuttlefish/host/libs/zip/libzip_cc:stat",
        "//cuttlefish/host/libs/zip/libzip_cc:writable_source",
        "//cuttlefish/io:filesystem",
        "//cuttlefish/io:reader_seeker",
        "//cuttlefish/result",
        "@abseil-cpp//absl/strings:string_view",
        "@libzip",
    ],
)

cf_cc_library(
    name = "error",
    srcs = ["error.cc"],
    hdrs = ["error.h"],
    features = ["-layering_check"],  # libzip
    linkstatic = True,  # libzip
    visibility = ["//visibility:private"],
    deps = [
        "//cuttlefish/host/libs/zip/libzip_cc:managed",
        "@libzip",
    ],
)

cf_cc_library(
    name = "managed",
    hdrs = ["managed.h"],
    features = ["-layering_check"],  # libzip
    linkstatic = True,  # libzip
    visibility = ["//visibility:private"],
    deps = ["@libzip"],
)

cf_cc_library(
    name = "readable_source",
    srcs = ["readable_source.cc"],
    hdrs = ["readable_source.h"],
    features = ["-layering_check"],  # libzip
    linkstatic = True,  # libzip
    deps = [
        "//cuttlefish/host/libs/zip/libzip_cc:error",
        "//cuttlefish/host/libs/zip/libzip_cc:managed",
        "//cuttlefish/host/libs/zip/libzip_cc:stat",
        "//cuttlefish/result:expect",
        "//cuttlefish/result:result_type",
        "@libzip",
    ],
)

cf_cc_library(
    name = "reader_seeker_io",
    srcs = ["reader_seeker_io.cc"],
    hdrs = ["reader_seeker_io.h"],
    deps = [
        "//cuttlefish/host/libs/zip/libzip_cc:seekable_source",
        "//cuttlefish/io",
        "//cuttlefish/io:reader_seeker",
        "//cuttlefish/io:visitable",
        "//cuttlefish/result:expect",
        "//cuttlefish/result:result_type",
    ],
)

cf_cc_library(
    name = "seekable_source",
    srcs = ["seekable_source.cc"],
    hdrs = ["seekable_source.h"],
    features = ["-layering_check"],  # libzip
    linkstatic = True,  # libzip
    deps = [
        "//cuttlefish/host/libs/zip/libzip_cc:error",
        "//cuttlefish/host/libs/zip/libzip_cc:managed",
        "//cuttlefish/host/libs/zip/libzip_cc:readable_source",
        "//cuttlefish/host/libs/zip/libzip_cc:source_reader",
        "//cuttlefish/io",
        "//cuttlefish/io:fake_pread_pwrite",
        "//cuttlefish/io:length",
        "//cuttlefish/io:reader_seeker",
        "//cuttlefish/io:visitable",
        "//cuttlefish/result",
        "@abseil-cpp//absl/base:no_destructor",
        "@libzip",
    ],
)

cf_cc_library(
    name = "source_reader",
    srcs = ["source_reader.cc"],
    hdrs = ["source_reader.h"],
    features = ["-layering_check"],  # libzip
    linkstatic = True,  # libzip
    deps = [
        "//cuttlefish/host/libs/zip/libzip_cc:error",
        "//cuttlefish/host/libs/zip/libzip_cc:readable_source",
        "//cuttlefish/io",
        "//cuttlefish/io:reader",
        "//cuttlefish/io:visitable",
        "//cuttlefish/result:expect",
        "//cuttlefish/result:result_type",
        "@libzip",
    ],
)

cf_cc_library(
    name = "stat",
    hdrs = ["stat.h"],
)

cf_cc_library(
    name = "writable_source",
    srcs = ["writable_source.cc"],
    hdrs = ["writable_source.h"],
    features = ["-layering_check"],  # libzip
    linkstatic = True,  # libzip
    deps = [
        "//cuttlefish/host/libs/zip/libzip_cc:error",
        "//cuttlefish/host/libs/zip/libzip_cc:managed",
        "//cuttlefish/host/libs/zip/libzip_cc:seekable_source",
        "//cuttlefish/io:visitable",
        "//cuttlefish/io:writer_seeker",
        "//cuttlefish/result",
        "@libzip",
    ],
)
