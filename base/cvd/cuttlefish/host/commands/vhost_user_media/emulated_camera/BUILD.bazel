load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("@vhost_user_media_workspace_crates//:defs.bzl", "crate_deps")

package(default_visibility = ["//:android_cuttlefish"])

rust_library(
    name = "emulated_camera",
    srcs = [
        "src/capture_channel.rs",
        "src/device.rs",
        "src/lib.rs",
        "src/pattern/julia_set.rs",
        "src/pattern/mod.rs",
        "src/pattern/pulse.rs",
        "src/pattern/smpte.rs",
    ],
    edition = "2024",
    target_compatible_with = ["@platforms//cpu:x86_64"],
    deps = crate_deps([
        "anyhow",
        "libc",
        "log",
        "thiserror",
        "v4l2r",
        "vhost-user-backend",
        "virtio-media",
        "vm-memory",
        "vmm-sys-util",
    ]) + [
        "//cuttlefish/host/commands/vhost_user_media/vhu_media",
    ],
)

rust_test(
    name = "emulated_camera_test",
    crate = ":emulated_camera",
    target_compatible_with = ["@platforms//cpu:x86_64"],
)
