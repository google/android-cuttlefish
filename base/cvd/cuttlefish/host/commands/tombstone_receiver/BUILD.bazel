load("//cuttlefish/bazel:rules.bzl", "cf_build_test", "cf_cc_binary")

package(
    default_visibility = ["//:android_cuttlefish"],
)

cf_build_test(name = "tombstone_receiver_build_test")

cf_cc_binary(
    name = "tombstone_receiver",
    srcs = ["main.cpp"],
    dynamic_deps = select({
        "@platforms//os:linux": [
            "//:absl_shared",
            "//:fmt_shared",
            "//:grpc_protobuf_shared",
            "//:jsoncpp_shared",
            "//cuttlefish/common/libs/fs:fs_shared",
            "//cuttlefish/common/libs/utils:files_shared",
            "//cuttlefish/host/libs/config:cuttlefish_config_shared",
            "//cuttlefish/result:result_shared",
        ],
        "//conditions:default": [],
    }),
    deps = [
        "//cuttlefish/common/libs/fs",
        "//cuttlefish/common/libs/fs:fd",
        "//cuttlefish/flag_parser",
        "//cuttlefish/flag_parser:shared_fd_flag",
        "//cuttlefish/host/libs/config:logging",
        "//cuttlefish/result:result_type",
        "@abseil-cpp//absl/log",
        "@abseil-cpp//absl/log:check",
        "@fmt",
    ],
)
