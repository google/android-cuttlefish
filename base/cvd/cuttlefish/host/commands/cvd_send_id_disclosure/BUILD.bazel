load("//cuttlefish/bazel:rules.bzl", "cf_cc_binary", "cf_cc_library", "cf_cc_test")

package(
    default_visibility = ["//:android_cuttlefish"],
)

cf_cc_binary(
    name = "cvd_send_id_disclosure",
    srcs = [
        "main.cc",
    ],
    depend_on_what_you_use_enabled = False,
    dynamic_deps = select({
        "@platforms//os:linux": [
            "//:absl_shared",
            "//:fmt_shared",
            "//:grpc_protobuf_shared",
            "//:jsoncpp_shared",
            "//cuttlefish/common/libs/fs:fs_shared",
            "//cuttlefish/common/libs/utils:files_shared",
            "//cuttlefish/host/libs/config:cuttlefish_config_shared",
            "//cuttlefish/result:result_shared",
        ],
        "//conditions:default": [],
    }),
    include_cleaner_enabled = False,
    deps = [
        ":libcvd_id_disclosure_builder",
        "//cuttlefish/common/libs/fs:fd",
        "//cuttlefish/common/libs/utils:tee_logging",
        "//cuttlefish/host/libs/config:cuttlefish_config",
        "//cuttlefish/io:write_exact",
        "//cuttlefish/io:writer",
        "//cuttlefish/result:result_type",
        "@abseil-cpp//absl/log",
        "@gflags",
    ],
)

cf_cc_library(
    name = "libcvd_id_disclosure_builder",
    srcs = [
        "cellular_identifier_disclosure_command_builder.cc",
    ],
    hdrs = [
        "cellular_identifier_disclosure_command_builder.h",
    ],
    include_cleaner_enabled = False,
    deps = [
        "@fmt",
    ],
)

cf_cc_test(
    name = "cvd_send_id_disclosure_test",
    srcs = [
        "unittest/cellular_identifier_disclosure_command_builder_test.cc",
    ],
    include_cleaner_enabled = False,
    deps = [":libcvd_id_disclosure_builder"],
)
