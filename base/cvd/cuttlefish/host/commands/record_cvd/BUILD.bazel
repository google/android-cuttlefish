load("//cuttlefish/bazel:rules.bzl", "cf_build_test", "cf_cc_binary")

package(
    default_visibility = ["//:android_cuttlefish"],
)

cf_build_test(name = "record_cvd_build_test")

cf_cc_binary(
    name = "record_cvd",
    srcs = ["record_cvd.cc"],
    dynamic_deps = select({
        "@platforms//os:linux": [
            "//:absl_shared",
            "//:fmt_shared",
            "//:grpc_protobuf_shared",
            "//:jsoncpp_shared",
            "//cuttlefish/common/libs/fs:fs_shared",
            "//cuttlefish/common/libs/utils:files_shared",
            "//cuttlefish/host/libs/config:cuttlefish_config_shared",
            "//cuttlefish/result:result_shared",
        ],
        "//conditions:default": [],
    }),
    deps = [
        "//cuttlefish/common/libs/utils:tee_logging",
        "//cuttlefish/host/libs/config:config_utils",
        "//cuttlefish/host/libs/config:cuttlefish_config",
        "//cuttlefish/host/libs/screen_recording_controls",
        "//cuttlefish/result",
        "@abseil-cpp//absl/log",
        "@gflags",
    ],
