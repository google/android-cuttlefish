load("//cuttlefish/bazel:rules.bzl", "cf_build_test", "cf_cc_binary", "cf_cc_library")

package(
    default_visibility = ["//:android_cuttlefish"],
)

cf_build_test(name = "sensors_simulator_build_test")

cf_cc_library(
    name = "libsensors_simulator",
    srcs = ["sensors_simulator.cpp"],
    hdrs = ["sensors_simulator.h"],
    deps = [
        "//cuttlefish/common/libs/sensors",
        "@libeigen",
    ],
)

cf_cc_library(
    name = "libsensors_hal_proxy",
    srcs = ["sensors_hal_proxy.cpp"],
    hdrs = ["sensors_hal_proxy.h"],
    deps = [
        ":libsensors_simulator",
        "//cuttlefish/common/libs/fs",
        "//cuttlefish/common/libs/sensors",
        "//cuttlefish/common/libs/transport:channel",
        "//cuttlefish/common/libs/utils:device_type",
        "//cuttlefish/host/commands/kernel_log_monitor:kernel_log_server",
        "//cuttlefish/host/commands/kernel_log_monitor:utils",
        "//cuttlefish/result:expect",
        "//cuttlefish/result:result_type",
        "@abseil-cpp//absl/log",
        "@abseil-cpp//absl/log:check",
    ],
)

cf_cc_binary(
    name = "sensors_simulator",
    srcs = ["main.cpp"],
    deps = [
        ":libsensors_hal_proxy",
        ":libsensors_simulator",
        "//cuttlefish/common/libs/fs",
        "//cuttlefish/common/libs/fs:fd",
        "//cuttlefish/common/libs/sensors",
        "//cuttlefish/common/libs/transport",
        "//cuttlefish/common/libs/transport:channel",
        "//cuttlefish/common/libs/utils:device_type",
        "//cuttlefish/host/libs/config:logging",
        "//cuttlefish/result:expect",
        "//cuttlefish/result:result_type",
        "@abseil-cpp//absl/log",
        "@gflags",
    ],
)
