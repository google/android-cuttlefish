load("//cuttlefish/bazel:rules.bzl", "cf_cc_binary")

package(
    default_visibility = ["//:android_cuttlefish"],
)

cf_cc_binary(
    name = "snapshot_util_cvd",
    srcs = [
        "main.cc",
        "parse.cc",
        "parse.h",
        "snapshot_taker.cc",
        "snapshot_taker.h",
    ],
    depend_on_what_you_use_enabled = False,
    dynamic_deps = select({
        "@platforms//os:linux": [
            "//:absl_shared",
            "//:fmt_shared",
            "//:grpc_protobuf_shared",
            "//:jsoncpp_shared",
            "//cuttlefish/common/libs/fs:fs_shared",
            "//cuttlefish/common/libs/utils:files_shared",
            "//cuttlefish/host/libs/config:cuttlefish_config_shared",
            "//cuttlefish/result:result_shared",
        ],
        "//conditions:default": [],
    }),
    include_cleaner_enabled = False,
    deps = [
        "//cuttlefish/common/libs/fs",
        "//cuttlefish/common/libs/utils:contains",
        "//cuttlefish/common/libs/utils:environment",
        "//cuttlefish/common/libs/utils:files",
        "//cuttlefish/common/libs/utils:json",
        "//cuttlefish/common/libs/utils:tee_logging",
        "//cuttlefish/common/libs/utils:users",
        "//cuttlefish/files:file_exists",
        "//cuttlefish/files:recursively_remove_directory",
        "//cuttlefish/flag_parser",
        "//cuttlefish/host/libs/command_util",
        "//cuttlefish/host/libs/command_util:libcuttlefish_run_cvd_proto",
        "//cuttlefish/host/libs/config:cuttlefish_config",
        "//cuttlefish/result",
        "@abseil-cpp//absl/cleanup",
        "@abseil-cpp//absl/log",
        "@abseil-cpp//absl/strings",
        "@android_system_libbase//:file_logging",
        "@fmt",
        "@gflags",
        "@protobuf",
    ],
)
