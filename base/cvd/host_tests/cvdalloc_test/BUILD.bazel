load("@rules_go//go:def.bzl", "go_test")

go_test(
    name = "cvdalloc_test",
    size = "large",
    srcs = [
        "main_test.go",
        "shared_bridge_test.go",
    ],
    data = ["//cuttlefish/host/commands/cvdalloc"],
    env = {"CVDALLOC_RLOCATION": "$(rlocationpath //cuttlefish/host/commands/cvdalloc:cvdalloc)"},
    env_inherit = ["CVDALLOC_BIN"],
    tags = [
        "exclusive",
        "external",
        "local",
        "no-sandbox",
    ],
    deps = [
        "//host_tests/common",
        "@com_github_google_go_cmp//cmp",
        "@com_github_google_go_cmp//cmp/cmpopts",
    ],
)
